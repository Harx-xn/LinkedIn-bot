generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  REGIONAL_ADMIN
  USER
}

model Region {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  code     String  @unique
  isActive Boolean @default(true)

  logoUrl         String?
  primaryColor    String?
  secondaryColor  String?
  customDomain    String?
  subdomain       String? @unique
  language        String? @default("en")
  currency        String? @default("USD")
  frontendVariant String? @default("default")

  // Per-tenant AI provider keys (sub-admin supplies; used by their clients' bots)
  openaiApiKey  String?
  geminiApiKeys String? // JSON array of keys, stored as string

  // Per-tenant LinkedIn app credentials
  linkedinClientId     String?
  linkedinClientSecret String?
  linkedinRedirectUri  String?
  linkedinApiVersion   String? @default("202511")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  botConfigs       BotConfig[]
  linkedinAccounts LinkedInAccount[]
  posts            Post[]
  schedules        Schedule[]
  sheetConfigs     SheetConfig[]
  generationJobs   BotGenerationJob[]
  subscriptions    Subscription[]
  plans            Plan[]
  paymentConfig    PaymentConfig?
  platformSettings PlatformSetting[]
  promotions       Promotion[]
  inviteLinks      InviteLink[]
}

model PaymentConfig {
  id       String @id @default(cuid())
  regionId String @unique

  provider String  @default("MANUAL") // STRIPE | PAYPAL | MANUAL
  isActive Boolean @default(true)

  // Stripe
  stripePublishableKey String?
  stripeSecretKey      String?
  stripeWebhookSecret  String?

  // PayPal
  paypalClientId     String?
  paypalClientSecret String?
  paypalMode         String? @default("sandbox") // sandbox | live

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  username     String @unique
  passwordHash String

  role     UserRole @default(USER)
  isActive Boolean  @default(true)
  themePreference String @default("LIGHT")

  // Free-trial tracking (14-day, no card required). Set at self-registration.
  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  linkedinClientId     String?
  linkedinClientSecret String?
  googleClientId       String?
  googleClientSecret   String?

  botConfigs       BotConfig?
  linkedinAccounts LinkedInAccount[]
  posts            Post[]
  schedules        Schedule[]
  sheetConfigs     SheetConfig[]
  subscriptions    Subscription[]
  BotGenerationJob BotGenerationJob[]
  promotionRedemptions PromotionRedemption[]
  inviteRedemptions InviteRedemption[]
  createdInviteLinks InviteLink[] @relation("InviteCreatedBy")

  @@index([regionId])
  @@index([role])
}

model BotConfig {
  id                 String   @id @default(cuid())
  userId             String   @unique
  regionId           String?
  niches             String
  sources            String
  customRssFeeds     String?
  customLinks        String?
  customRedditFeeds  String?
  backgroundImageUrl String?
  postingSchedule    String?
  postsPerWeek       Int      @default(7)
  generationWindow   Int      @default(7)
  isEnabled          Boolean  @default(false)
  description        String?  @default("")
  tone               String?  @default("Professional")
  includeContactInfo Boolean  @default(false)
  includeWebsiteLink Boolean  @default(false)
  contactInfo        String?
  websiteUrl         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([regionId])
}

model LinkedInAccount {
  id                      String   @id @default(cuid())
  userId                  String
  regionId                String?
  authorUrn               String
  selectedOrganizationUrn String?
  accessToken             String
  refreshToken            String?
  expiresAt               DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  posts  Post[]

  @@index([userId])
  @@index([regionId])
}

model Schedule {
  id        String   @id @default(cuid())
  userId    String
  regionId  String?
  timezone  String
  cron      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([regionId])
}

model Post {
  id                String    @id @default(cuid())
  userId            String
  regionId          String?
  linkedinAccountId String?
  source            String    @default("MANUAL")
  status            String    @default("DRAFT")
  content           String
  hashtags          String?
  scheduledAt       DateTime?
  publishedAt       DateTime?
  linkedinPostUrn   String?
  mediaUrl          String?
  errorMessage      String?
  rewriteCount      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  linkedinAccount LinkedInAccount? @relation(fields: [linkedinAccountId], references: [id], onDelete: SetNull)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  region          Region?          @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([regionId])
  @@index([status, regionId])
}

model BotGenerationJob {
  id             String    @id @default(cuid())
  userId         String?
  regionId       String?
  daysWindow     Int
  status         String    @default("RUNNING")
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  error          String?
  completedSlots Int       @default(0)
  totalSlots     Int       @default(0)

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([regionId, createdAt])
}

model SheetConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  regionId      String?
  spreadsheetId String   @default("")
  range         String   @default("")
  accessToken   String?
  refreshToken  String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([regionId])
}

model Plan {
  id           String  @id @default(cuid())
  name         String
  code         String
  price        Float
  currency     String
  billingCycle String
  isActive     Boolean @default(true)

  // Optional: useful later if you create Stripe products/prices manually
  stripePriceId String?

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@unique([code, regionId])
  @@index([regionId])
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  regionId  String?
  planId    String

  status    String    @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELED | INCOMPLETE
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  autoRenew Boolean   @default(true)

  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripeCheckoutSessionId String?
  promotionCode String?
  inviteCode String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  plan   Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  promotionRedemptions PromotionRedemption[]

  @@index([userId])
  @@index([regionId])
  @@index([planId])
  @@unique([stripeSubscriptionId])
}


model PlatformSetting {
  id        String   @id @default(cuid())
  scope     String   @default("GLOBAL") // GLOBAL | REGION
  regionId  String?
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region Region? @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([scope, regionId, key])
  @@index([regionId])
  @@index([key])
}

model Promotion {
  id                    String    @id @default(cuid())
  regionId              String?
  code                  String
  name                  String
  description           String?
  isActive              Boolean   @default(true)

  // STRIPE_PROMO applies a Stripe promotion_code during Checkout.
  // INTERNAL_TRIAL adds extra free trial days during registration.
  // CAMPAIGN is attribution-only.
  type                  String    @default("STRIPE_PROMO")
  stripePromotionCodeId String?
  stripeCouponId        String?
  extraTrialDays        Int?
  maxRedemptions        Int?
  redemptionCount       Int       @default(0)
  startsAt              DateTime?
  endsAt                DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  region      Region? @relation(fields: [regionId], references: [id], onDelete: Cascade)
  redemptions PromotionRedemption[]

  @@unique([code, regionId])
  @@index([regionId])
  @@index([code])
  @@index([isActive])
}

model PromotionRedemption {
  id             String   @id @default(cuid())
  promotionId    String
  userId         String
  regionId       String?
  subscriptionId String?
  redeemedAt     DateTime @default(now())

  promotion    Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([promotionId, userId])
  @@index([userId])
  @@index([regionId])
}

model InviteLink {
  id              String   @id @default(cuid())
  regionId        String?
  code            String   @unique
  createdByUserId String?
  roleToAssign    UserRole @default(USER)

  email           String?
  maxUses         Int?
  usedCount       Int      @default(0)
  expiresAt       DateTime?
  isActive        Boolean  @default(true)
  promoCode       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  region      Region? @relation(fields: [regionId], references: [id], onDelete: Cascade)
  createdBy   User?   @relation("InviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  redemptions InviteRedemption[]

  @@index([regionId])
  @@index([code])
  @@index([isActive])
}

model InviteRedemption {
  id           String   @id @default(cuid())
  inviteLinkId String
  userId       String
  redeemedAt   DateTime @default(now())

  inviteLink InviteLink @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteLinkId, userId])
  @@index([userId])
}

model PaymentEvent {
  id        String   @id @default(cuid())
  provider  String   @default("STRIPE")
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now())
}