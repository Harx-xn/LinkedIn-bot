generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  linkedinClientId     String?
  linkedinClientSecret String?

  googleClientId     String?
  googleClientSecret String?

  linkedinAccounts LinkedInAccount[]
  schedules        Schedule[]
  posts            Post[]
  sheetConfigs     SheetConfig[]
  botConfig        BotConfig?
}

model BotConfig {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id])
  userId             String   @unique
  niches             String // JSON array: ["technology", "marketing", "finance"]
  sources            String // JSON array: ["reddit", "medium", "google"]
  customRssFeeds     String? // JSON array: ["https://techcrunch.com/feed", ...]
  customLinks        String? // JSON array: ["https://example.com/article1", ... (User provided links)]
  customRedditFeeds  String? // JSON array: ["https://www.reddit.com/r/all/hot.json", ...]
  backgroundImageUrl String? // Path or URL to background image
  postingSchedule    String? // e.g. "0 9 * * *"
  postsPerWeek       Int      @default(7)
  generationWindow   Int      @default(7) // Days to generate for
  isEnabled          Boolean  @default(false)
  description        String?  @default("")
  tone               String?  @default("Professional") // "Professional", "Casual", "Humorous", etc.
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model LinkedInAccount {
  id                      String   @id @default(cuid())
  user                    User     @relation(fields: [userId], references: [id])
  userId                  String
  authorUrn               String // Personal URN (urn:li:person:xxx)
  selectedOrganizationUrn String? // Organization URN if posting to page (urn:li:organization:xxx)
  accessToken             String
  refreshToken            String?
  expiresAt               DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Back relation to Post.linkedinAccount
  posts Post[]
}

model Schedule {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  timezone  String // e.g. "Asia/Karachi"
  cron      String // e.g. "0 10 * * 1-5" for 10:00 Mon–Fri
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  linkedinAccount   LinkedInAccount? @relation(fields: [linkedinAccountId], references: [id])
  linkedinAccountId String?

  // Using String instead of enums to avoid connector enum limitation
  // Suggested values:
  //   source: "GOOGLE_SHEET" | "AI" | "MANUAL"
  //   status: "DRAFT" | "QUEUED" | "PUBLISHED" | "FAILED"
  source String @default("MANUAL")
  status String @default("DRAFT")

  content  String
  hashtags String? // you can store comma-separated or JSON

  scheduledAt     DateTime?
  publishedAt     DateTime?
  linkedinPostUrn String?
  mediaUrl        String? // Path or URL to the generated/attached image

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SheetConfig {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  spreadsheetId String
  range         String // e.g. "Posts!A:D"
  accessToken   String?
  refreshToken  String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}