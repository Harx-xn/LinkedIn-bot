generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  REGIONAL_ADMIN
  USER
}

enum BillingAccessStatus {
  BILLING_REQUIRED
  TRIAL_PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  PAYMENT_ACTION_REQUIRED
  PAUSED
  CANCELED
  INCOMPLETE
}

model Region {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  code     String  @unique
  isActive Boolean @default(true)

  logoUrl         String?
  primaryColor    String?
  secondaryColor  String?
  customDomain    String?
  subdomain       String? @unique
  language        String? @default("en")
  currency        String? @default("USD")
  frontendVariant String? @default("default")

  // Per-tenant AI provider keys (sub-admin supplies; used by their clients' bots)
  openaiApiKey  String?
  geminiApiKeys String? // JSON array of keys, stored as string

  // Per-tenant LinkedIn app credentials
  linkedinClientId     String?
  linkedinClientSecret String?
  linkedinRedirectUri  String?
  linkedinApiVersion   String? @default("202511")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                      User[]
  botConfigs                 BotConfig[]
  linkedinAccounts           LinkedInAccount[]
  posts                      Post[]
  schedules                  Schedule[]
  sheetConfigs               SheetConfig[]
  generationJobs             BotGenerationJob[]
  subscriptions              Subscription[]
  plans                      Plan[]
  paymentConfig              PaymentConfig?
  platformSettings           PlatformSetting[]
  promotions                 Promotion[]
  inviteLinks                InviteLink[]
  imageGenerationUsages      ImageGenerationUsage[]
  manualAiRewriteUsages      ManualAiRewriteUsage[]
  carouselAiGenerationUsages CarouselAiGenerationUsage[]
  carouselProjects           CarouselProject[]
  supportRequests            SupportRequest[]
}

model PaymentConfig {
  id       String @id @default(cuid())
  regionId String @unique

  provider String  @default("MANUAL") // STRIPE | SAFEPAY | PAYPAL | MANUAL
  isActive Boolean @default(true)

  // Stripe
  stripePublishableKey String?
  stripeSecretKey      String?
  stripeWebhookSecret  String?

  // PayPal
  paypalClientId     String?
  paypalClientSecret String?
  paypalMode         String? @default("sandbox") // sandbox | live

  // Safepay (separate credentials are expected per environment)
  safepayPublicKey     String?
  safepaySecretKey     String?
  safepayWebhookSecret String?
  safepayEnvironment   String? @default("SANDBOX") // SANDBOX | LIVE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  username     String  @unique
  passwordHash String?

  role                          UserRole @default(USER)
  isActive                      Boolean  @default(true)
  themePreference               String   @default("LIGHT")
  hasCompletedOnboardingTour    Boolean  @default(false)
  hasCompletedProfileOnboarding Boolean  @default(false)
  needsIdentityOnboarding       Boolean  @default(false)

  // Trial tracking — trial starts only after Stripe Checkout + webhook confirmation.
  trialStartedAt      DateTime?
  trialEndsAt         DateTime?
  trialRedeemedAt     DateTime?
  billingAccessStatus BillingAccessStatus @default(BILLING_REQUIRED)
  stripeCustomerId    String?
  isBillingExempt     Boolean             @default(false)
  billingExemptAt     DateTime?
  billingExemptById   String?
  billingExemptReason String?

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  linkedinClientId     String?
  linkedinClientSecret String?
  googleClientId       String?
  googleClientSecret   String?

  botConfigs                 BotConfig?
  linkedinAccounts           LinkedInAccount[]
  posts                      Post[]
  schedules                  Schedule[]
  sheetConfigs               SheetConfig[]
  subscriptions              Subscription[]
  BotGenerationJob           BotGenerationJob[]
  promotionRedemptions       PromotionRedemption[]
  inviteRedemptions          InviteRedemption[]
  notifications              Notification[]
  createdInviteLinks         InviteLink[]                @relation("InviteCreatedBy")
  imageGenerationUsages      ImageGenerationUsage[]
  manualAiRewriteUsages      ManualAiRewriteUsage[]
  carouselAiGenerationUsages CarouselAiGenerationUsage[]
  carouselProjects           CarouselProject[]
  nicheSearchPlans           UserNicheSearchPlan[]
  topicHistory               GeneratedTopicHistory[]
  topicInventory             TopicInventory[]
  voiceProfile               UserVoiceProfile?
  postContentFingerprints    PostContentFingerprint[]
  authProviderAccounts       AuthProviderAccount[]
  supportRequests            SupportRequest[]
  linkedinAnalyticsImports   LinkedInAnalyticsImport[]
  linkedinProfileSnapshots   LinkedInProfileSnapshot[]

  @@index([regionId])
  @@index([role])
  @@index([isBillingExempt])
}

enum LinkedInAnalyticsStatus {
  PROCESSING
  ANALYZING
  READY
  FAILED
}

model LinkedInAnalyticsImport {
  id                String                  @id @default(cuid())
  userId            String
  periodStart       DateTime
  periodEnd         DateTime
  status            LinkedInAnalyticsStatus @default(PROCESSING)
  impressions       Int                     @default(0)
  membersReached    Int                     @default(0)
  engagementCount   Int                     @default(0)
  followerCount     Int?
  normalizedData    Json
  deterministicData Json
  analysisError     String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  user         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyMetrics LinkedInAnalyticsDailyMetric[]
  postMetrics  LinkedInAnalyticsPostMetric[]
  demographics LinkedInAnalyticsDemographic[]
  insights     LinkedInAnalyticsInsight[]

  @@unique([userId, periodStart, periodEnd])
  @@index([userId, periodEnd])
}

model LinkedInAnalyticsDailyMetric {
  id           String   @id @default(cuid())
  importId     String
  date         DateTime
  impressions  Int      @default(0)
  engagements  Int      @default(0)
  newFollowers Int?

  analyticsImport LinkedInAnalyticsImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, date])
  @@index([importId])
}

model LinkedInAnalyticsPostMetric {
  id              String    @id @default(cuid())
  importId        String
  linkedinPostUrl String
  publishedAt     DateTime?
  impressions     Int       @default(0)
  engagements     Int       @default(0)
  engagementRate  Float     @default(0)
  matchedPostId   String?
  enrichment      Json?
  createdAt       DateTime  @default(now())

  analyticsImport LinkedInAnalyticsImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([matchedPostId])
}

model LinkedInAnalyticsDemographic {
  id       String @id @default(cuid())
  importId String
  type     String
  label    String
  value    Float

  analyticsImport LinkedInAnalyticsImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, type])
}

model LinkedInProfileSnapshot {
  id          String   @id @default(cuid())
  userId      String
  name        String?
  headline    String?
  location    String?
  summary     String?
  skills      Json
  experience  Json?
  education   Json?
  linkedinUrl String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model LinkedInAnalyticsInsight {
  id             String   @id @default(cuid())
  importId       String
  type           String
  importance     String
  title          String
  finding        String
  recommendation String
  nextMove       String?
  evidence       Json
  confidence     Float?
  createdAt      DateTime @default(now())

  analyticsImport LinkedInAnalyticsImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, importance])
}

model AuthProviderAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model OAuthState {
  id        String   @id @default(cuid())
  provider  String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UserVoiceProfile {
  id     String @id @default(cuid())
  userId String @unique

  profile          Json
  preferredPhrases Json?
  avoidedPhrases   Json?
  approvedPatterns Json?
  rejectedPatterns Json?

  analyzedSampleCount Int   @default(0)
  version             Int   @default(1)
  confidence          Float @default(0)

  lastAnalyzedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TopicHistoryStatus {
  GENERATED
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
}

enum TopicInventoryStatus {
  AVAILABLE
  RESERVED
  CONSUMED
  EXPIRED
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PostAttachmentType {
  NONE
  IMAGE
  CAROUSEL
}

enum CarouselAttachmentStatus {
  CURRENT
  OUTDATED
  GENERATING
  FAILED
}

model UserNicheSearchPlan {
  id                     String   @id @default(cuid())
  userId                 String
  niche                  String
  domain                 String
  confidence             Float
  subtopics              Json
  queries                Json
  exclusions             Json
  version                Int      @default(1)
  schemaVersion          Int      @default(1)
  queryGenerationVersion Int      @default(1)
  aliasGenerationVersion Int      @default(1)
  inputFingerprint       String?
  generatedAt            DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, niche])
  @@index([userId])
}

model GeneratedTopicHistory {
  id              String             @id @default(cuid())
  userId          String
  postId          String?
  batchId         String?
  sourceTitle     String?
  normalizedTopic String
  topicCluster    String
  coreClaim       String?
  angle           String?
  status          TopicHistoryStatus
  generatedAt     DateTime           @default(now())
  publishedAt     DateTime?
  updatedAt       DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@index([userId, topicCluster])
  @@index([userId, normalizedTopic])
  @@index([postId])
}

model TopicInventory {
  id                 String               @id @default(cuid())
  userId             String
  niche              String
  title              String
  normalizedTopic    String
  coreClaim          String?
  semanticCluster    String?
  mechanism          String?
  intent             String?
  relevanceScore     Float
  strategyScore      Float
  confidenceScore    Float
  sourceQualityScore Float
  noveltyScore       Float
  recencyScore       Float
  finalScore         Float
  sourceUrl          String?
  sourceName         String?
  discoverySource    String?
  evidenceRole       String?
  evidenceSummary    String?
  supportingSources  Json?
  fingerprint        String
  profileFingerprint String?
  sourcePublishedAt  DateTime?
  discoveredAt       DateTime             @default(now())
  expiresAt          DateTime?
  status             TopicInventoryStatus @default(AVAILABLE)
  reservedByJobId    String?
  reservedAt         DateTime?
  consumedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, status])
  @@index([userId, niche, status])
  @@index([expiresAt])
}

model BotConfig {
  id                 String   @id @default(cuid())
  userId             String   @unique
  regionId           String?
  niches             String
  sources            String
  backgroundImageUrl String?
  imageMode          String? // none | providedBackground | aiGenerated
  imageInstructions  String?
  imageStyle         String?
  imageAspectRatio   String? // 1:1 | 4:5 | 16:9
  brandLogoUrl       String?
  brandLogoEnabled   Boolean  @default(false)
  brandLogoPosition  String   @default("bottomRight")
  isEnabled          Boolean  @default(false)
  description        String?  @default("")
  tone               String?  @default("Conversational")
  includeContactInfo Boolean  @default(false)
  includeWebsiteLink Boolean  @default(false)
  contactInfo        String?
  websiteUrl         String?
  profilePositioning Json?
  targetAudience     Json?
  contentGoals       Json?
  contentPillars     Json?
  topicRules         Json?
  writingStyle       Json?
  timeSlots          Json     @default("[\"09:00\"]")
  onboardingStatus   String   @default("LEGACY")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([regionId])
  @@index([onboardingStatus])
}

model LinkedInAccount {
  id                      String   @id @default(cuid())
  userId                  String
  regionId                String?
  authorUrn               String
  linkedInMemberId        String?
  profileName             String?
  profileEmail            String?
  profileImageUrl         String?
  selectedOrganizationUrn String?
  accessToken             String
  refreshToken            String?
  expiresAt               DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  posts  Post[]

  @@index([userId])
  @@index([regionId])
}

model Schedule {
  id        String   @id @default(cuid())
  userId    String
  regionId  String?
  timezone  String
  cron      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([regionId])
}

model Post {
  id                       String                    @id @default(cuid())
  userId                   String
  regionId                 String?
  linkedinAccountId        String?
  source                   String                    @default("MANUAL")
  status                   String                    @default("DRAFT")
  content                  String
  hashtags                 String?
  scheduledAt              DateTime?
  publishedAt              DateTime?
  linkedinPostUrn          String?
  mediaUrl                 String?
  attachmentType           PostAttachmentType        @default(NONE)
  carouselProjectId        String?
  carouselPdfUrl           String?
  carouselFileName         String?
  carouselUpdatedAt        DateTime?
  carouselAttachmentStatus CarouselAttachmentStatus?
  errorMessage             String?
  rewriteCount             Int                       @default(0)
  manualTopic              String?
  aiGenerated              Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  linkedinAccount    LinkedInAccount?        @relation(fields: [linkedinAccountId], references: [id], onDelete: SetNull)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region             Region?                 @relation(fields: [regionId], references: [id], onDelete: SetNull)
  contentFingerprint PostContentFingerprint?
  carouselProject    CarouselProject?        @relation(fields: [carouselProjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([regionId])
  @@index([status, regionId])
  @@index([carouselProjectId])
}

model PostContentFingerprint {
  id     String @id @default(cuid())
  postId String @unique
  userId String

  primaryTopic String
  subtopic     String?
  coreClaim    String
  structure    String?
  hookType     String?
  evidenceType String?
  ctaType      String?
  keywords     Json?

  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, primaryTopic])
  @@index([userId, createdAt])
}

model BotGenerationJob {
  id             String    @id @default(cuid())
  userId         String?
  regionId       String?
  daysWindow     Int
  status         String    @default("RUNNING")
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  error          String?
  completedSlots Int       @default(0)
  totalSlots     Int       @default(0)

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([regionId, createdAt])
}

model SheetConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  regionId      String?
  spreadsheetId String   @default("")
  range         String   @default("")
  accessToken   String?
  refreshToken  String?
  active        Boolean  @default(true)
  authStatus    String   @default("CONNECTED")
  lastSyncError String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([regionId])
}

model Plan {
  id           String  @id @default(cuid())
  name         String
  code         String
  price        Float
  currency     String
  billingCycle String
  isActive     Boolean @default(true)

  // Optional: useful later if you create Stripe products/prices manually
  stripePriceId String?

  // Feature toggles / usage limits enforced server-side per active subscription.
  fullDashboardUnlock           Boolean @default(true)
  maxRewritesPerPost            Int     @default(3)
  dailyPostLimit                Int     @default(5)
  dailyBatchGenerationLimit     Int     @default(1)
  monthlyPostLimit              Int?
  monthlyBatchGenerationLimit   Int?
  imageGenerationEnabled        Boolean @default(false)
  dailyImageGenerationLimit     Int     @default(0)
  monthlyImageGenerationLimit   Int?
  monthlyManualAiOperationLimit Int?
  carouselSaveLimit             Int?
  carouselAiGenerationLimit     Int?
  convertPostToCarouselEnabled  Boolean @default(false)

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions    Subscription[]
  providerMappings PlanProviderMapping[]

  @@unique([code, regionId])
  @@index([regionId])
}

model PlanProviderMapping {
  id                String   @id @default(cuid())
  planId            String
  provider          String
  environment       String   @default("LIVE")
  providerPlanId    String?
  providerProductId String?
  providerPriceId   String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, provider, environment])
  @@index([provider, providerPlanId])
  @@index([provider, providerPriceId])
}

model Subscription {
  id       String  @id @default(cuid())
  userId   String
  regionId String?
  planId   String

  status    String    @default("ACTIVE") // TRIALING | ACTIVE | PAST_DUE | PAYMENT_ACTION_REQUIRED | INCOMPLETE | PAUSED | CANCELED
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  autoRenew Boolean   @default(true)

  // Provider ownership is immutable after creation. The regional selection only
  // controls new checkouts.
  provider                     String  @default("MANUAL")
  providerSubscriptionId       String?
  providerCustomerId           String?
  providerStatus               String?
  providerPaymentMethodPresent Boolean @default(false)

  stripeCustomerId             String?
  stripeSubscriptionId         String? @unique
  stripeCheckoutSessionId      String?
  stripeSubscriptionItemId     String?
  stripeLatestInvoiceId        String?
  stripeDefaultPaymentMethodId String?
  promotionCode                String?
  inviteCode                   String?

  cancelAtPeriodEnd        Boolean   @default(false)
  canceledAt               DateTime?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  trialStart               DateTime?
  trialEnd                 DateTime?
  paymentFailedAt          DateTime?
  paymentActionRequiredAt  DateTime?
  lastStripeEventCreatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  region               Region?               @relation(fields: [regionId], references: [id], onDelete: SetNull)
  plan                 Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  promotionRedemptions PromotionRedemption[]
  billingTransactions  BillingTransaction[]

  @@unique([provider, providerSubscriptionId])
  @@index([userId])
  @@index([regionId])
  @@index([planId])
  @@index([provider, providerCustomerId])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  scope     String   @default("GLOBAL") // GLOBAL | REGION
  regionId  String?
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region Region? @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([scope, regionId, key])
  @@index([regionId])
  @@index([key])
}

model Promotion {
  id          String  @id @default(cuid())
  regionId    String?
  code        String
  name        String
  description String?
  isActive    Boolean @default(true)

  // STRIPE_PROMO applies a Stripe promotion_code during Checkout.
  // INTERNAL_TRIAL adds extra free trial days during registration.
  // CAMPAIGN is attribution-only.
  type                  String    @default("STRIPE_PROMO")
  stripePromotionCodeId String?
  stripeCouponId        String?
  extraTrialDays        Int?
  maxRedemptions        Int?
  redemptionCount       Int       @default(0)
  startsAt              DateTime?
  endsAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region      Region?               @relation(fields: [regionId], references: [id], onDelete: Cascade)
  redemptions PromotionRedemption[]

  @@unique([code, regionId])
  @@index([regionId])
  @@index([code])
  @@index([isActive])
}

model PromotionRedemption {
  id             String   @id @default(cuid())
  promotionId    String
  userId         String
  regionId       String?
  subscriptionId String?
  redeemedAt     DateTime @default(now())

  promotion    Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([promotionId, userId])
  @@index([userId])
  @@index([regionId])
}

model InviteLink {
  id              String   @id @default(cuid())
  regionId        String?
  code            String   @unique
  createdByUserId String?
  roleToAssign    UserRole @default(USER)

  email     String?
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  promoCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region      Region?            @relation(fields: [regionId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("InviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  redemptions InviteRedemption[]

  @@index([regionId])
  @@index([code])
  @@index([isActive])
}

model InviteRedemption {
  id           String   @id @default(cuid())
  inviteLinkId String
  userId       String
  redeemedAt   DateTime @default(now())

  inviteLink InviteLink @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteLinkId, userId])
  @@index([userId])
}

model PaymentEvent {
  id              String    @id @default(cuid())
  provider        String    @default("STRIPE")
  eventId         String    @unique
  type            String
  stripeCreatedAt DateTime?
  status          String    @default("RECEIVED")
  attempts        Int       @default(0)
  processedAt     DateTime?
  errorMessage    String?
  regionId        String?
  payload         Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model BillingTransaction {
  id                    String    @id @default(cuid())
  subscriptionId        String?
  userId                String
  regionId              String?
  provider              String
  providerInvoiceId     String?
  providerTransactionId String?
  amount                Int
  amountPaid            Int       @default(0)
  currency              String
  status                String
  periodStart           DateTime?
  periodEnd             DateTime?
  paidAt                DateTime?
  failedAt              DateTime?
  receiptUrl            String?
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerTransactionId])
  @@index([userId, createdAt])
  @@index([subscriptionId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// One row per successfully generated AI image. Used to enforce the per-plan
// daily image generation limit (counted by createdAt within the UTC day).
model ImageGenerationUsage {
  id        String   @id @default(cuid())
  userId    String
  regionId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([regionId, createdAt])
}

// Tracks successful manual-composer AI generate/rewrite operations for daily limits.
model ManualAiRewriteUsage {
  id        String   @id @default(cuid())
  userId    String
  regionId  String?
  kind      String
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([regionId, createdAt])
}

// One row per successful AI carousel generation. Usage is counted within the
// subscription billing period (falling back to the UTC month when necessary).
model CarouselAiGenerationUsage {
  id        String   @id @default(cuid())
  userId    String
  regionId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([regionId, createdAt])
}

model CarouselProject {
  id          String   @id @default(cuid())
  userId      String
  regionId    String?
  title       String
  projectJson String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region        Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  attachedPosts Post[]

  @@index([userId, updatedAt])
  @@index([regionId, updatedAt])
}

model SupportRequest {
  id         String               @id @default(cuid())
  userId     String
  regionId   String?
  subject    String
  message    String
  status     SupportRequestStatus @default(OPEN)
  adminNote  String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  resolvedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([regionId, status, createdAt])
  @@index([status])
}
