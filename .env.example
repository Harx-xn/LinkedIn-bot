DATABASE_URL="postgresql://user:password@localhost:5432/linkedin_bot"
WEB_SEARCH_ENDPOINT="https://your-search-provider.example/search"
WEB_SEARCH_API_KEY="your-web-search-api-key"
REDDIT_CLIENT_ID="your-reddit-client-id"
REDDIT_CLIENT_SECRET="your-reddit-client-secret"
REDDIT_USER_AGENT="VeyraisContentIntelligence/1.0"

JWT_SECRET="super-secret-change-me"
RENDER = true
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_REDIRECT_URI="http://localhost:4000/api/linkedin/callback"
LINKEDIN_AUTH_REDIRECT_URI="http://localhost:4000/api/auth/linkedin/callback"
LINKEDIN_API_VERSION="202511"
# Set to "true" ONLY after your LinkedIn app is approved for the Community
# Management API (real post analytics). Until then leave it false/unset, or the
# OAuth connect flow will be rejected by LinkedIn. After enabling, users must
# re-connect their LinkedIn account to grant the new analytics scopes.
LINKEDIN_ENABLE_ANALYTICS_SCOPES="false"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/sheets/callback"
GOOGLE_AUTH_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"
FRONTEND_URL="http://localhost:5173"
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="linkedin-bot-images"
R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Veyrais
# Use the authenticated mailbox, or another sender on the same Namecheap domain that the account permits.
SMTP_FROM_EMAIL=
APP_URL=
